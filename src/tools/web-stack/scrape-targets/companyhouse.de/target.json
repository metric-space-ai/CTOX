{
  "target_key": "companyhouse-de",
  "display_name": "CompanyHouse DE Handelsregister Aggregator",
  "start_url": "https://www.companyhouse.de/",
  "target_kind": "prospect-research",
  "status": "active",
  "config": {
    "expected_provider": "companyhouse",
    "country_hints": ["DE"],
    "tier": "S",
    "adapter_version": "v1",
    "skip_probe": true,
    "expected_min_records": 1,
    "record_key_fields": ["field", "source_url"],
    "access_mode": "public_browser_with_unlock_retry",
    "provider_owned_only": true,
    "allowed_domains": ["companyhouse.de", "www.companyhouse.de"],
    "challenge_detection": true,
    "unlock_signal_source": "scrape-target:companyhouse.de",
    "unlock_retry": "provider_browser_warmup",
    "persistent_browser_session_input": "browser_session_id",
    "heal_mode": "versioned_script",
    "failure_modes": ["blocked", "portal_drift", "temporary_unreachable"],
    "api": {
      "semantic": {
        "source_fields": ["value", "note"]
      }
    }
  },
  "output_schema": {
    "schema_key": "prospect.v1",
    "primary_artifact_kind": "field_records_json",
    "record_key_fields": ["field", "source_url"]
  }
}
