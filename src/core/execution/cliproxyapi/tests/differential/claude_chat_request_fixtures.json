[
  {
    "name": "chat-simple-controls",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "stream": true,
    "input": {
      "messages": [{"role":"user","content":"hello"}],
      "max_tokens": 123,
      "top_p": 0.75,
      "stop": ["END", "STOP"],
      "reasoning_effort": "low"
    }
  },
  {
    "name": "chat-system-string-cache",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {
      "messages": [
        {"role":"system","content":"Be exact.","cache_control":{"type":"ephemeral"}},
        {"role":"user","content":"question"}
      ]
    }
  },
  {
    "name": "chat-system-array-message-cache",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {
      "messages": [
        {"role":"system","content":[{"type":"text","text":"A"},{"type":"text","text":"B"}],"cache_control":{"type":"ephemeral"}},
        {"role":"user","content":[{"type":"text","text":"ask"}],"cache_control":{"type":"ephemeral"}}
      ]
    }
  },
  {
    "name": "chat-image-file-and-url",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {
      "messages": [{"role":"user","content":[
        {"type":"text","text":"inspect"},
        {"type":"image_url","image_url":{"url":"data:image/png;base64,AA=="}},
        {"type":"image_url","image_url":{"url":"https://example.invalid/image.png"}},
        {"type":"file","file":{"file_data":"data:application/pdf;base64,UEZG"}}
      ]}]
    }
  },
  {
    "name": "chat-tools-schema-choice",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {
      "messages": [{"role":"user","content":"lookup"}],
      "tools": [{"type":"function","cache_control":{"type":"ephemeral"},"function":{
        "name":"lookup","description":"Lookup item",
        "parameters":{"type":"object","properties":{"id":{"type":"integer"}},"required":["id"]}
      }}],
      "tool_choice": {"type":"function","function":{"name":"lookup"}}
    }
  },
  {
    "name": "chat-tool-call-and-grouped-results",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {
      "messages": [
        {"role":"assistant","content":"checking","tool_calls":[
          {"id":"call:one","type":"function","function":{"name":"first","arguments":"{\"x\":1}"}},
          {"id":"call-two","type":"function","function":{"name":"second","arguments":"[]"}}
        ]},
        {"role":"tool","tool_call_id":"call:one","content":"one"},
        {"role":"tool","tool_call_id":"call-two","content":[{"type":"text","text":"two"}]}
      ]
    }
  },
  {
    "name": "chat-system-only-minimal-turn",
    "operation": "chat_request_to_claude",
    "model": "legacy-claude",
    "input": {"messages":[{"role":"system","content":"Only system"}]}
  },
  {
    "name": "chat-adaptive-reasoning",
    "operation": "chat_request_to_claude",
    "model": "claude-sonnet-4-6",
    "input": {
      "reasoning_effort":"xhigh",
      "messages":[{"role":"user","content":"think"}],
      "tool_choice":"auto"
    }
  }
]
